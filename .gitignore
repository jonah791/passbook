# Flutter / Dart
app/.dart_tool/
app/build/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/*.iml
app/.idea/

# 平台构建产物
app/windows/flutter/ephemeral/
app/android/.gradle/
app/android/local.properties
app/android/app/build/
app/android/key.properties
app/android/app/*.jks

# 杂项
*.log
.DS_Store

# golden 比对失败时 Flutter 落的对比图（生成物，不是证据）
app/test/failures/

# 库文件绝不进版本库（这是密码本，一次误提交等于永久泄露）
*.kdbx

# 发布产物（由 scripts/release.ps1 生成，走 GitHub Release 分发，不进版本库）
dist/

# 本机工具链（Android SDK 等，体积大且每人不同）
_tools/
